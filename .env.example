# ── 1) 카카오맵: 국내 여행 (README의 "카카오맵 설정" 참고) ──
# JavaScript 키: 지도 표시와 장소 검색
VITE_KAKAO_JS_KEY=
# REST API 키: 구간 이동시간 계산. 앞에 VITE_를 붙이지 마세요(브라우저에 노출되지 않게 개발 서버만 씀)
KAKAO_REST_API_KEY=

# ── 2) 구글 지도: 해외 여행 (README의 "구글 지도 API 키 발급" 참고) ──
VITE_GOOGLE_MAPS_API_KEY=
# 선택: 클라우드 지도 스타일용 Map ID. 비워 두면 개발용 DEMO_MAP_ID를 씁니다.
VITE_GOOGLE_MAP_ID=

# ── 3) Supabase: 로그인 + 클라우드 저장 (README의 "Supabase 설정" 참고) ──
# 비워 두면 로그인 없이 이 브라우저에만 저장하는 로컬 모드로 실행됩니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
